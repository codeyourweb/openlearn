# Copy to .env and adjust. Every variable is optional; the defaults target a
# local, private instance. See docs/DEPLOYMENT.md for the full reference.

# --- Identity of the instance ------------------------------------------------
OL_INSTANCE_NAME=OpenLearn
# Absolute URL: share links, password-reset e-mails and SSO callbacks use it.
OL_PUBLIC_BASE_URL=https://learn.example.com
# Set to "true" when served over HTTPS (Secure cookies + HSTS). Automatically
# applied when the request arrives through a proxy that sets X-Forwarded-Proto.
OL_COOKIE_SECURE=false
# Signing key for sessions and SSO state. Leave empty to generate one into the
# data volume (fine for a single node; must be shared by replicas).
OL_SECRET_KEY=

# --- Published port (docker compose) ----------------------------------------
PORT=8000
APP_PORT=8000

# --- Administration bootstrap ----------------------------------------------
# Created at boot, or promoted to administrator if the account exists.
OL_ADMIN_EMAIL=admin@example.com
OL_ADMIN_PASSWORD=

# --- Database ---------------------------------------------------------------
# SQLite (default):
# OL_DATABASE_URL=sqlite:////app/data/openlearn.db
# PostgreSQL:
# OL_DATABASE_URL=postgresql+psycopg://openlearn:openlearn@db:5432/openlearn
# MariaDB / MySQL:
# OL_DATABASE_URL=mysql+pymysql://openlearn:openlearn@db:3306/openlearn?charset=utf8mb4
# Credentials used by the database overlays:
POSTGRES_USER=openlearn
POSTGRES_PASSWORD=openlearn
POSTGRES_DB=openlearn
MYSQL_USER=openlearn
MYSQL_PASSWORD=openlearn
MYSQL_DATABASE=openlearn
MYSQL_ROOT_PASSWORD=change-me-root

# --- Demo -------------------------------------------------------------------
# A demo instance loads demo/content/*.json and shows the presentation page as
# the entry screen. A private instance leaves this off.
OL_DEMO_MODE=false
OL_SEED_DEMO_DATA=true
OL_DEMO_PASSWORD=DemoPassw0rd!

# --- AI (optional) ----------------------------------------------------------
# When disabled, every AI control disappears from the interface. These values
# only seed the database: the administration panel has the last word.
OL_AI_ENABLED=false
OL_AI_BASE_URL=http://127.0.0.1:11434/v1
OL_AI_API_KEY=
OL_AI_MODEL=
# OL_AI_WIKI_MODEL=
OL_AI_TIMEOUT_SECONDS=180
OL_AI_MIN_INTERVAL_SECONDS=15

# --- Mail (optional, needed for password resets) ----------------------------
OL_MAIL_ENABLED=false
OL_MAIL_HOST=
OL_MAIL_PORT=587
OL_MAIL_USERNAME=
OL_MAIL_PASSWORD=
OL_MAIL_FROM_ADDRESS=
OL_MAIL_FROM_NAME=OpenLearn
OL_MAIL_STARTTLS=true
OL_MAIL_SSL=false

# --- Audit forwarding (optional: syslog / HTTP POST to a SIEM or XDR) --------
# Speech transcripts of the reading content, produced at editing time by a local
# engine. Off by default: no service is contacted until this is on and a URL is
# set. See docs/AUDIO.md and deploy/qwen-tts/.
OL_AUDIO_ENABLED=false
OL_AUDIO_SERVICE_URL=
OL_AUDIO_MODEL=qwen3-tts
OL_AUDIO_VOICE_FEMALE=Serena
OL_AUDIO_VOICE_MALE=Aiden
OL_AUDIO_MAX_CHARS=12000
OL_AUDIO_CHUNK_CHARS=900
OL_AUDIO_CONCURRENCY=1
OL_AUDIO_TIMEOUT_SECONDS=1800

OL_LOG_ENABLED=false
OL_LOG_SYSLOG_HOST=
OL_LOG_SYSLOG_PORT=514
OL_LOG_SYSLOG_PROTOCOL=udp
OL_LOG_SYSLOG_FACILITY=13
# OL_LOG_SYSLOG_HOSTNAME=openlearn.example.org
OL_LOG_SYSLOG_TLS_VERIFY=true
OL_LOG_HTTP_URL=
OL_LOG_HTTP_TOKEN=
OL_LOG_HTTP_VERIFY_TLS=true
OL_LOG_HTTP_TIMEOUT_SECONDS=5

# --- Features ----------------------------------------------------------------
OL_SSO_ENABLED=true
OL_MCP_ENABLED=true
OL_MCP_REQUIRE_AUTH=true
# OL_TLS_CERT_FILE=/certs/fullchain.pem
# OL_TLS_KEY_FILE=/certs/privkey.pem
# OL_TLS_PORT=8443
