    {
      "title": "Biology: The Human Cell and Its Organelles",
      "description": "Nine questions on the machinery inside a human cell: what each organelle does and how a cell copies and divides itself.",
      "mode": "qcm",
      "wrong_answer_policy": "zero",
      "default_language": "en",
      "title_translations": {
        "fr": "Biologie : la cellule humaine et ses organites",
        "de": "Biologie: Die menschliche Zelle und ihre Organellen",
        "es": "Biología: la célula humana y sus orgánulos"
      },
      "description_translations": {
        "fr": "Neuf questions sur la machinerie d'une cellule humaine : le rôle de chaque organite, la copie de l'ADN et la division cellulaire.",
        "de": "Neun Fragen zur Maschinerie einer menschlichen Zelle: die Aufgabe jeder Organelle, das Kopieren der DNA und die Zellteilung.",
        "es": "Nueve preguntas sobre la maquinaria de una célula humana: la función de cada orgánulo, la copia del ADN y la división celular."
      },
      "timer_mode": "per_question",
      "questions": [
        {
          "text_html": "<p>Which organelle produces most of a cell's ATP?</p>",
          "time_limit_seconds": 25,
          "points": 100,
          "options": [
            {
              "text": "The mitochondrion",
              "is_correct": true
            },
            {
              "text": "The ribosome",
              "is_correct": false
            },
            {
              "text": "The Golgi apparatus",
              "is_correct": false
            },
            {
              "text": "The lysosome",
              "is_correct": false
            }
          ]
        },
        {
          "text_html": "<p>Select <b>all</b> structures found in a human cell but <i>not</i> in a bacterium.</p>",
