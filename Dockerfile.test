# syntax=docker/dockerfile:1
# Test image: pytest (backend, API, OWASP) + Playwright (frontend end-to-end).
# The Playwright base image ships Chromium and all of its system libraries.
# The base image ships the browser binaries, the pip package drives them: the two
# versions must be identical, or every scenario fails with "Executable doesn't
# exist". `tests/test_toolchain_versions.py` holds the pair together.
FROM mcr.microsoft.com/playwright/python:v1.64.1-noble

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY backend/requirements.txt /app/backend/requirements.txt
COPY backend/requirements-dev.txt /app/backend/requirements-dev.txt
RUN pip install --no-cache-dir -r /app/backend/requirements.txt -r /app/backend/requirements-dev.txt

COPY backend /app/backend
COPY frontend /app/frontend
COPY tests /app/tests
COPY demo /app/demo
COPY tools /app/tools
COPY docs /app/docs
COPY pytest.ini /app/pytest.ini
RUN chmod -R a+rX /app/backend /app/frontend /app/tests /app/demo /app/tools /app/docs

ENV PYTHONPATH=/app/backend \
    OL_TEST_BASE_URL=http://127.0.0.1:8000

CMD ["pytest", "-ra", "tests"]
